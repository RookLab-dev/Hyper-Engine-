# Hyper-Engine environment template.
# Copy this file to .env and fill in your real values.
# Every name below matches a field in src/core/config.py (case-insensitive).
# Defaults shown here are the code defaults — uncomment/override only what you need.

# ── Hyperliquid credentials ──
HL_PRIVATE_KEY=your_private_key_here
HL_ACCOUNT_ADDRESS=your_wallet_address_here
HL_BASE_URL=https://api.hyperliquid-testnet.xyz

# ── Network safety ──
# Always false until fully verified. Never set true without explicit confirmation.
IS_MAINNET=false

# ── Trading settings ──
SYMBOL=BTC
INTERVAL=1h
POSITION_SIZE=0.001
SLIPPAGE_PCT=0.001

# ── Capital & risk ──
INITIAL_CAPITAL=10000.0
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_OPEN_POSITIONS=3

# ── Strategy settings ──
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
RSI_PERIOD=14
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0
BB_PERIOD=20
BB_NUM_STD=2.0
VWAP_MODE=crossover
VWAP_NUM_STD=2.0

# ── Backtester settings ──
BACKTEST_CANDLES=500
MIN_SHARPE_TO_TRADE=0.5

# ── Runner settings ──
SLEEP_SECONDS=60
RUN_HOURS=2.0
LOG_DIR=logs

# ── Testnet live execution (src/execution/) ──
# Master safety switch for REAL Hyperliquid TESTNET order execution.
# Backtesting and paper trading NEVER place real orders, regardless of
# this setting. Leave false unless deliberately running the testnet
# BUY->SELL smoke test (poetry run python -m execution.smoke_test)
# or live testnet execution. IS_MAINNET must also be false.
ENABLE_TESTNET_LIVE_EXECUTION=false
EXECUTION_POLL_INTERVAL_SECONDS=1.0
EXECUTION_POLL_TIMEOUT_SECONDS=30.0
